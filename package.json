{
  "name": "taxi-business-manager",
  "version": "1.1.0",
  "description": "Taxi Business Management Dashboard",
  "author": "Taxi Business Management",
  "private": true,
  "main": "main.js",
  "homepage": "https://taxi-business-manager.example.com",
  "dependencies": {
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/share": "^8.0.0",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.7.3",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prebuild-electron": "node create-icon.js && npm run build",
    "build-electron": "npm run prebuild-electron && electron-builder --win --x64",
    "electron-start": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "package-win": "npm run build-electron",
    "package-win-stable": "npm run prebuild-electron && npx electron-packager . \"Taxi Business Management System\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=build-resources/icon.ico",
    "package-win-installer": "npx electron-installer-windows --src \"dist/Taxi Business Management System-win32-x64\" --dest dist/installers"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "chart.js": "^4.5.1",
    "dexie": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0",
    "firebase": "^10.0.0",
    "png-to-ico": "^3.0.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.taxi.dashboard",
    "productName": "Taxi Business Management System",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "TaxiBusinessManagementSystem_Setup.${ext}",
      "publisherName": "Taxi Business",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "cscLink": null,
      "signingHashAlgorithms": [],
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taxi Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "en_US"
      ],
      "license": "LICENSE.txt",
      "warningsAsErrors": false
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "asarUnpack": [
      "build/**/*"
    ],
    "asar": true,
    "compression": "normal",
    "extends": null
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}