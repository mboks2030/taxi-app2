# ==============================================================================
# TAXI BUSINESS MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# In Create React App, frontend environment variables MUST start with REACT_APP_
# to be embedded in the production build.
#
# Obtain these values from your Supabase Project Settings:
# https://supabase.com/dashboard/project/_/settings/api

# Your unique project URL (e.g. https://xyzcompany.supabase.co)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Your project's public "anon" publishable API key
# SAFE for client-side apps with Row Level Security (RLS) enabled.
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: NEVER put your service-role key or database password in this file!
